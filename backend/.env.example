# ── VagaBot — variáveis de ambiente ──────────────────────────────────────────
# Copie este arquivo para .env e preencha com seus dados.
# NUNCA suba o .env para o GitHub — ele já está no .gitignore.

# Gmail — use uma "Senha de app", não sua senha normal
# Como gerar: myaccount.google.com → Segurança → Senhas de app
GMAIL_USER=seu@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# E-mail que vai receber as vagas (pode ser o mesmo do GMAIL_USER)
DESTINATARIO=seu@gmail.com

# GitHub Personal Access Token (opcional, mas aumenta o limite de requisições)
# Como gerar: github.com → Settings → Developer settings → Tokens (classic)
# Permissões necessárias: public_repo (leitura apenas)
GITHUB_TOKEN=ghp_seu_token_aqui

# Frequência de busca em horas (padrão: 6)
INTERVALO_HORAS=6

# Score mínimo de compatibilidade para notificar — 0 a 100 (padrão: 60)
MATCH_MINIMO=60
