# Gmail — use uma "Senha de app", não sua senha normal
# Como criar: myaccount.google.com → Segurança → Senhas de app
GMAIL_USER=seu@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# E-mail que vai receber as vagas
DESTINATARIO=seu@gmail.com

# Frequência de busca em horas
INTERVALO_HORAS=6

# Score mínimo para notificar (0-100)
MATCH_MINIMO=70
