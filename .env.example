# ── VagaBot — variáveis de ambiente ──────────────────────────────────────────
# Copie para .env e preencha. NUNCA suba o .env para o GitHub.

# ── Gmail ─────────────────────────────────────────────────────────────────────
GMAIL_USER=seu@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
DESTINATARIO=seu@gmail.com

# ── GitHub ────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_seu_token_aqui

# ── LinkedIn RSS (opcional) ───────────────────────────────────────────────────
# Como gerar: linkedin.com/jobs/search → salve a busca → copie o link RSS
LINKEDIN_RSS_URL=

# ── Comportamento ─────────────────────────────────────────────────────────────
INTERVALO_HORAS=6
MATCH_MINIMO=60

# ── Ativar/desativar fontes (true/false) ──────────────────────────────────────
ATIVAR_GUPY=true
ATIVAR_VAGAS_COM=true
ATIVAR_PROGRAMATHOR=true
ATIVAR_LINKEDIN=true
