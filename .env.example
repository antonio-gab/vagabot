# ── VagaBot — variáveis de ambiente ──────────────────────────────────────────
# Copie este arquivo para .env e preencha com seus dados.
# NUNCA suba o .env para o GitHub — ele já está no .gitignore.

# ── Gmail ─────────────────────────────────────────────────────────────────────
# Use uma "Senha de app", não sua senha normal do Google.
# Como gerar: myaccount.google.com → Segurança → Senhas de app
GMAIL_USER=seu@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# E-mail que vai receber as vagas (pode ser o mesmo do GMAIL_USER)
DESTINATARIO=seu@gmail.com

# ── GitHub ────────────────────────────────────────────────────────────────────
# Token do GitHub para aumentar o limite de requisições (60 → 5000/hora).
# Como gerar: github.com → Settings → Developer settings → Tokens (classic)
# Permissões necessárias: nenhuma (só leitura de repos públicos)
GITHUB_TOKEN=ghp_seu_token_aqui

# ── Comportamento ─────────────────────────────────────────────────────────────
# Frequência de busca em horas (padrão: 6)
INTERVALO_HORAS=6

# Score mínimo de compatibilidade para enviar por e-mail — 0 a 100 (padrão: 60)
MATCH_MINIMO=60

# ── Fontes RSS opcionais ──────────────────────────────────────────────────────
# Ativar quando tiver URLs RSS válidas configuradas nos scrapers.
ATIVAR_GUPY=false
ATIVAR_VAGAS_COM=false
ATIVAR_PROGRAMATHOR=false
